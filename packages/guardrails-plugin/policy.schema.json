{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-guardrails policy",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "isolation": { "type": "boolean" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "decision", "kind", "match", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["deny", "ask"] },
          "kind": { "enum": ["path", "command", "tool"] },
          "match": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "except": { "type": "array", "items": { "type": "string" } },
          "project_relative": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "step_cap": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "max_calls": { "type": "integer", "minimum": 1 } }
    },
    "untrusted_tools": { "type": "array", "items": { "type": "string" } },
    "trusted_tools": { "type": "array", "items": { "type": "string" } },
    "injection_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pattern"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "pattern": { "type": "string" } }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_chars": { "type": "integer", "minimum": 100 },
        "otel_field_names": { "type": "boolean" }
      }
    }
  }
}
